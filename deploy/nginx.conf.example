# Merge into an existing HTTPS server block; certificate provisioning is external.
# No deployment has been performed or validated on amazoniabowls.com.
location /tibia/ {
    alias /srv/tibia/client/;
    index otclient.html;
    add_header Cross-Origin-Opener-Policy same-origin always;
    add_header Cross-Origin-Embedder-Policy require-corp always;
    add_header Cross-Origin-Resource-Policy same-origin always;
    # Include nginx mime.types at http{} level, including application/wasm.
}
# OTClient's transport currently constructs host:port with no URL path.
